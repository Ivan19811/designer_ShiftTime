    },
    {
      "from": "тіки",
      "to": "тільки",
      "type": "spelling_phrase"
    },
    {
      "from": "градиент",
      "to": "градієнт",
      "type": "spelling_phrase"
    },
    {
      "from": "вертекальний",
      "to": "вертикальний",
      "type": "spelling_phrase"
    },
    {
      "from": "догори дригом",
      "to": "догори ногами",
      "type": "rotation_phrase"
    },
    {
      "from": "у центр",
      "to": "по центру",
      "type": "align_phrase"
    },
    {
      "from": "в центр",
      "to": "по центру",
      "type": "align_phrase"
    },
    {
      "from": "в право",
      "to": "вправо",
      "type": "direction_phrase"
    },
    {
      "from": "в ліво",
      "to": "вліво",
      "type": "direction_phrase"
    },
    {
      "from": "а також",
      "to": "також",
      "type": "chain_phrase"
    },
    {
      "from": "чуть чуть",
      "to": "трохи",
      "type": "soft_phrase"
    },
    {
      "from": "м яку",
      "to": "мяку",
      "type": "spelling_phrase"
    },
    {
      "from": "синьо жовто зелений",
      "to": "синій жовтий зелений",
      "type": "color_phrase"
    },
    {
      "from": "синьо жовтий",
      "to": "синій жовтий",
      "type": "color_phrase"
    }
  ]
}