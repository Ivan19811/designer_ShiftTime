      "type": "direction_phrase"
    },
    {
      "from": "по горизонталі",
      "to": "горизонтальний",
      "type": "direction_phrase"
    },
    {
      "from": "зліва направо",
      "to": "горизонтальний",
      "type": "direction_phrase"
    },
    {
      "from": "справа наліво",
      "to": "справа наліво",
      "type": "direction_phrase"
    },
    {
      "from": "зверху вниз",
      "to": "вертикальний",
      "type": "direction_phrase"
    },
    {
      "from": "знизу вгору",
      "to": "знизу вгору",
      "type": "direction_phrase"
    },
    {
      "from": "перші 2",
      "to": "перші дві",
      "type": "scope_phrase"
    },
    {
      "from": "2 і 3",
