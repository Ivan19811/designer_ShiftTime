{
  "meta": {
    "version": 1,
    "description": "Phrase-level normalization before token parsing"
  },
  "rules": [
    {
      "from": "з верху",
      "to": "зверху",
      "type": "exact_phrase"
    },
    {
      "from": "з низу",
      "to": "знизу",
      "type": "exact_phrase"
    },
    {
      "from": "по середині",
      "to": "посередині",
      "type": "exact_phrase"
    },
    {
      "from": "в середині",
      "to": "всередині",
      "type": "exact_phrase"
    },
    {
      "from": "синьо жовтий",
      "to": "синьо-жовтий",
      "type": "color_phrase"
    },
    {
      "from": "жовто синій",
      "to": "жовто-синій",
      "type": "color_phrase"
    },
    {
