# 01092 · ShiftTime Tables + Real PostgreSQL + Marketplace/Admin + Media Cloud R2/S3 Backend
NODE_ENV=development
PORT=8787
HOST=127.0.0.1

# Backend-only secret. Never expose DATABASE_URL to browser code.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/shifttime
# auto = respect sslmode from DATABASE_URL/provider. require = force TLS. disable = no TLS.
DATABASE_SSL=auto
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=shifttime-tables-01092
MIGRATION_LOCK_TIMEOUT_MS=60000
PRODUCTION_GUARD_STRICT=false

# Explicit frontend origin in production, e.g. https://studio.example.com
CORS_ORIGIN=*

# Temporary DEV/bootstrap session path. 01084 Real Auth is authoritative for normal users.
DEV_SESSION_TOKEN=change-me-dev-token
DEV_USER_EMAIL=owner@local.shifttime
DEV_USER_NAME=ShiftTime Owner

# 01084 Real Auth
AUTH_REGISTRATION_ENABLED=true
# Opaque Bearer session lifetime. Default 720h = 30 days; server clamps to 1h..90d.
AUTH_SESSION_TTL_HOURS=720

# 01087 Admin invitations are generated as one-time links in the Admin UI.
# Email delivery provider is intentionally not configured in this stage.

# 01076 payment foundation
MARKETPLACE_COMMISSION_RATE=8
DEV_PAYMENT_SIMULATION=true

# 01077 inventory reservation foundation
INVENTORY_RESERVATION_MINUTES=15
DEV_INVENTORY_SIMULATION=true

# 01078 shipping foundation
DEV_SHIPPING_SIMULATION=true

# 01080 one-time production bootstrap. Keep disabled except while executing db:bootstrap-owner.
BOOTSTRAP_OWNER_ENABLED=false
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=ShiftTime Owner
# Use a generated secret >=32 chars. It is hashed in PostgreSQL and never logged.
BOOTSTRAP_SESSION_TOKEN=
BOOTSTRAP_SESSION_TTL_HOURS=12
BOOTSTRAP_ACCOUNT_ID=acct_default
BOOTSTRAP_ACCOUNT_NAME=Моя організація
BOOTSTRAP_WORKSPACE_ID=ws_default
BOOTSTRAP_WORKSPACE_NAME=Основний Workspace
BOOTSTRAP_STORE_ID=store_default
BOOTSTRAP_STORE_NAME=Основний магазин

# Optional CLI safety / backup settings
# IMPORT_CONFIRM_STORE_ID=store_default
# BACKUP_DIR=/secure/path/outside/project

# 01081 cloud media storage. R2 is S3-compatible.
# disabled | r2 | s3 | s3-compatible
MEDIA_STORAGE_PROVIDER=disabled
# R2 example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=false
# Optional public custom domain/CDN, e.g. https://media.example.com .
# If empty, public media route redirects to short-lived signed GET URLs.
MEDIA_PUBLIC_BASE_URL=
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_DOWNLOAD_URL_TTL_SECONDS=3600
MEDIA_MAX_UPLOAD_BYTES=62914560
